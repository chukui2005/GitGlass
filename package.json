{
  "name": "gitglass",
  "version": "0.1.0",
  "private": true,
  "description": "A transparent Git commit workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.2.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
