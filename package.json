{
  "name": "gitglass",
  "version": "0.6.1",
  "private": true,
  "description": "A transparent Git commit workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "prepare:electron": "install-electron",
    "pretest": "npm run prepare:electron",
    "test": "vitest run",
    "prepack:win": "npm run prepare:electron",
    "pack:win": "electron-builder --win --x64 --publish never",
    "checksum:win": "node scripts/write-release-checksums.mjs",
    "dist:win": "npm run build && npm run pack:win && npm run checksum:win",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "js-yaml": "4.3.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "io.github.chukui2005.gitglass",
    "productName": "GitGlass",
    "asar": true,
    "icon": "public/icon.ico",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/**",
      "package.json",
      "LICENSE",
      "!tests/**",
      "!output/**",
      "!.env",
      "!.env.*",
      "!.screenshots/**",
      "!.trae-html-share-packages/**"
    ],
    "artifactName": "GitGlass-${version}-win-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "chukui2005",
      "repo": "GitGlass"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "GitGlass-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.3"
  }
}
