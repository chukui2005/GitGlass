{
  "name": "gitglass",
  "version": "0.6.5-beta.3",
  "private": true,
  "description": "A transparent Git commit workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare:electron": "install-electron",
    "pretest": "npm run prepare:electron",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack:win": "npm run prepare:electron",
    "pack:win": "electron-builder --win --x64 --publish never",
    "checksum:win": "node scripts/write-release-checksums.mjs",
    "release": "node scripts/release.mjs",
    "dist:win": "npm run build && npm run pack:win && npm run checksum:win",
    "verify:release": "node scripts/verify-release.mjs",
    "report:size": "node scripts/report-size.mjs",
    "report:startup": "node scripts/report-startup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/react": "2.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "10.0.7",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "js-yaml": "4.3.2",
    "jsdom": "^27.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "io.github.chukui2005.gitglass",
    "productName": "GitGlass",
    "asar": true,
    "icon": "public/icon.ico",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/**",
      "package.json",
      "LICENSE",
      "!tests/**",
      "!output/**",
      "!.env",
      "!.env.*",
      "!.screenshots/**",
      "!.trae-html-share-packages/**",
      "!node_modules/@phosphor-icons/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**",
      "!**/*.map"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "artifactName": "GitGlass-${version}-win-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "chukui2005",
      "repo": "GitGlass"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "GitGlass-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "semver": "7.8.3"
  }
}
